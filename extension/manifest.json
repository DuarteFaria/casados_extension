{
  "manifest_version": 3,
  "name": "Opto Rank",
  "version": "1.0.0",
  "description": "Extensão não oficial: dá nota aos episódios e filmes da Opto SIC (Intancável → Cinema) e conta os Momentos o7.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://opto.sic.pt/*",
    "https://agreeable-antelope-656.eu-west-1.convex.cloud/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://opto.sic.pt/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
